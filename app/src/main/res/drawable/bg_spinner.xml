<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/emp_background"/>
            <stroke
                android:width="1dp"
                android:color="@color/emp_outline"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_unfold"
        android:end="14dp"
        android:gravity="center_vertical|end"/>
</layer-list>
