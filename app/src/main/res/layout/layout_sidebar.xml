<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebar"
    android:layout_width="304dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/sidebar_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="32dp"
    android:paddingEnd="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        android:letterSpacing="0.15"
        android:text="EMPLOYEE"
        android:textColor="@color/emp_icon_muted"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/menuYourBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_calendar"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="Your Bookings"
        android:textColor="@android:color/white"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuMakeBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_add_circle"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="Make Booking"
        android:textColor="@android:color/white"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuBookingRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_send"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="Your Booking Requests"
        android:textColor="@android:color/white"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuCancellationRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_cancel"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="Your Cancellation Requests"
        android:textColor="@android:color/white"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_history"
        android:drawablePadding="12dp"
        android:drawableTint="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="Your History"
        android:textColor="@android:color/white"
        android:textSize="15sp"/>

</LinearLayout>
